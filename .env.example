# Required
ANTHROPIC_API_KEY=
GROCY_API_KEY=

# Claude model and how hard it thinks (low | medium | high)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# Voice: any OpenAI-compatible transcription endpoint. Leave the key empty to use
# the phone's built-in speech recognition instead (works on Android Chrome, patchy on iPhone).
#   Groq:   https://api.groq.com/openai/v1  + whisper-large-v3-turbo
#   OpenAI: https://api.openai.com/v1       + gpt-4o-mini-transcribe
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# Cloudflare Access (Zero Trust > Access > Applications > your app). When both are
# set, every request must carry a valid Access token. Strongly recommended.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: how the assistant addresses people
# USER_NAMES=mom@example.com=Mom,grandma@example.com=Dadi
# DAILY_MESSAGE_LIMIT=300
