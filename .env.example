# Required
ANTHROPIC_API_KEY=
GROCY_API_KEY=

# Claude model and how hard it thinks (low | medium | high)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# Voice, best option: Deepgram live transcription. Words appear while you speak, and
# "multi" handles Hindi and English mixed in one sentence. Key from console.deepgram.com.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=multi

# Voice, alternative (used only when DEEPGRAM_API_KEY is empty): any OpenAI-compatible
# transcription endpoint. Words appear after you stop speaking. Leave both keys empty to use
# the phone's built-in speech recognition instead (works on Android Chrome, patchy on iPhone).
#   Groq:   https://api.groq.com/openai/v1  + whisper-large-v3-turbo
#   OpenAI: https://api.openai.com/v1       + gpt-4o-mini-transcribe
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# Cloudflare Access (Zero Trust > Access > Applications > your app). When both are
# set, every request must carry a valid Access token. Strongly recommended.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: how the assistant addresses people
# USER_NAMES=mom@example.com=Mom,grandma@example.com=Dadi
# DAILY_MESSAGE_LIMIT=300

# Address of Grocy in the browser, for the "Open Grocy" link in the menu
# GROCY_PUBLIC_URL=https://grocy.example.com
# Per-person Grocy API keys, so Grocy's own journal shows who did what
# GROCY_USER_KEYS=mom@example.com=abc123,grandma@example.com=def456
